# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/

# 리멤버 명함첩 내보내기 CSV — 외부인의 이름·휴대폰·이메일·주소가 들어 있다.
# 올리는 용도로 잠깐 내려받는 파일이라 저장소에 들어가서는 안 된다(한 번
# 커밋되면 이력에서 지우기 어렵다). 업로드는 화면에서 하고 파일은 지운다.
개인명함첩_*.csv
