NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 뉴스·예산 모니터링 키워드 추가 시 즉시 백필(app/dashboard/actions/monitor-keywords.ts)에
# 쓰는 서버 전용 키 — airpass-naver-monitor(.env)와 같은 값을 그대로 쓴다.
# NAVER_OPENAPI_*는 NAVER API HUB(뉴스 검색), G2B_SERVICE_KEY는 data.go.kr
# "조달청_나라장터 입찰공고정보서비스"에서 발급받는다. 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다
# (브라우저로 노출되면 안 되는 키).
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=
G2B_SERVICE_KEY=

# 협력사 관리 등 AI 문서 자동추출 기능용 — 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다
# (서버 전용, 브라우저로 노출되면 안 되는 키).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 자료메일발송 기능용. Google Cloud에서 서비스 계정을 만들고 Drive API를 활성화한
# 뒤, 그 서비스 계정 이메일(GOOGLE_SERVICE_ACCOUNT_EMAIL)을 자료 폴더에 "편집자"
# 이상 권한으로 공유해야 한다(단순 "뷰어"로는 발송 직전 파일 공유 링크를 만들지
# 못해 실패한다). GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY는 서비스 계정 JSON 키의
# private_key 값을 그대로(줄바꿈은 \n으로 이스케이프된 상태 그대로) 붙여넣는다.
# GOOGLE_DRIVE_MATERIALS_FOLDER_ID는 자료 폴더 URL의 마지막 부분(폴더 ID).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_MATERIALS_FOLDER_ID=

# Work Journal/Memo Board/제조사 관리 첨부파일 업로드용(2026-09-02, Supabase 스토리지
# 용량 초과 대응). "루트" 폴더를 하나 만들어 그 폴더 ID를 넣으면, 서비스별 하위 폴더
# ("Work Journal"/"Memo Board"/"제조사 관리")는 최초 업로드 시 코드가 자동으로 만든다.
#
# 주의: 위 서비스 계정으로는 업로드가 안 된다 — 구글 서비스 계정은 자체 저장용량이
# 0이라 파일 생성(쓰기)이 storageQuotaExceeded로 막힌다(읽기·공유만 가능, 2026-09-03
# 실측 확인). 이 루트 폴더는 실제 구글 계정 소유여야 하고, 그 계정을 앱 안
# /dashboard/admin의 "첨부파일 업로드용 구글드라이브 연결" 카드에서 OAuth로 한 번
# 연결해야 실제로 동작한다(GOOGLE_CALENDAR_CLIENT_ID/SECRET을 그대로 재사용하는 OAuth
# 플로우, app/auth/google-drive-upload/*).
#
# 이 값이 비어 있거나 OAuth 연결이 안 돼 있으면 예전처럼 Supabase Storage에 올라간다
# (하위 호환, 기존 파일도 그대로 열람됨) — 즉 둘 다 필수는 아니고, 설정+연결하면 그
# 시점부터 새로 올리는 파일만 전환된다.
GOOGLE_DRIVE_ATTACHMENTS_ROOT_FOLDER_ID=

# 자료메일발송 발신용 SMTP. 이메일 API(Resend 등) 대신 실제 회사 메일 계정에 직접
# 로그인해서 그 이름으로 보낸다 — 도메인 인증은 필요 없지만, 그 계정의 로그인
# 비밀번호를 그대로 쓰므로(한비로는 앱 전용 비밀번호가 없음, 2026-08-23 확인)
# 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다. 한비로는 airpass.hanbiro.net:465(SSL) —
# 다른 메일 서비스로 바꾸면 HOST/PORT만 그 서비스 값으로 교체하면 된다. 발송 전에
# 메일 서비스 웹 설정에서 POP3/SMTP 사용을 켜둬야 하고(예: 한비로 메일 >
# 환경설정 > 기본 설정), 해외 IP 차단 설정이 있다면 Vercel 리전도 허용해야 한다.
MATERIAL_EMAIL_SMTP_HOST=
MATERIAL_EMAIL_SMTP_PORT=
MATERIAL_EMAIL_SMTP_USER=
MATERIAL_EMAIL_SMTP_PASSWORD=
MATERIAL_EMAIL_FROM_NAME=

# Calendar 화면에서 개인 구글 캘린더 일정을 불러오는 기능용. Google Cloud
# Console → API 및 서비스 → 사용자 인증 정보에서 "OAuth 클라이언트 ID"(웹
# 애플리케이션)를 만들고, 승인된 리디렉션 URI에 아래 두 개를 등록해야 한다.
#   http://localhost:3000/auth/google-calendar/callback
#   https://<배포 도메인>/auth/google-calendar/callback
# Calendar API를 활성화하고, OAuth 동의 화면에 calendar.readonly + openid +
# email 범위를 추가해야 한다. 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# AI Issue(/dashboard/ai-issue, app/api/cron/ai-issues) 보호용. Vercel Cron이
# 이 라우트를 매일 호출할 때 Authorization: Bearer $CRON_SECRET 헤더를 자동으로
# 붙이므로(vercel.json), 그냥 무작위 문자열을 넣어두면 된다(예: openssl rand -hex 32).
CRON_SECRET=

# 외부에서 만든 Claude 스킬/서비스가 AI Review에 자동으로 글을 올릴 때 쓰는
# 수신 API(app/api/ai-review/ingest) 보호용 — 호출부가 이 값을
# Authorization: Bearer $AI_REVIEW_INGEST_SECRET 헤더로 보내야 한다. 무작위
# 문자열을 넣어두면 된다(예: openssl rand -hex 32).
AI_REVIEW_INGEST_SECRET=

# 할 일(/dashboard/todos) 알람 브라우저 푸시용 VAPID 키(2026-09-11).
# `npx web-push generate-vapid-keys`로 한 번만 생성해서 그대로 고정해 쓴다
# (키가 바뀌면 기존에 저장된 모든 브라우저 구독이 무효화됨). PUBLIC 키는
# 브라우저(NEXT_PUBLIC_)로 노출되고, PRIVATE 키는 서버 전용.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@airpass.co.kr

# 알람 발송 크론(app/api/cron/todo-alarms) 보호용 — Vercel Cron이 아니라
# cron-job.org 같은 외부 무료 스케줄러가 5분마다 이 라우트를 호출한다(Vercel
# Hobby 플랜은 cron을 하루 1회로 강제 제한해 정시 알람이 불가능하기 때문,
# 2026-09-11 확인). 호출 시 Authorization: Bearer $CRON_SECRET 헤더가 필요 —
# 위 CRON_SECRET과 같은 값을 그대로 재사용한다(새 값 아님).
